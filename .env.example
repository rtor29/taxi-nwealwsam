# =====================================================================
# Taxi-Wisam Platform Environment Configuration
# =====================================================================

# Server Port & Environment
PORT=5050
NODE_ENV=production

# Self-Hosted PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taxiwisam
PGHOST=localhost
PGPORT=5432
PGDATABASE=taxiwisam
PGUSER=postgres
PGPASSWORD=postgres

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1122

# Paths
DATA_FILE=./data/state.json
UPLOADS_DIR=./data/uploads
DASHBOARD_DIR=./src/TaxiWisam.Api/wwwroot/dashboard
FLUTTER_WEB_DIR=./apps/taxi_wisam_flutter/build/web
